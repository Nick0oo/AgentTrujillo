{
  "name": "agent-trujillo",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
    "verify:eve-baseline": "node scripts/verify-eve-baseline.mjs",
    "verify:discovery": "node scripts/verify-eve-discovery.mjs",
    "verify:supabase-parity": "node scripts/verify-supabase-parity.mjs",
    "generate:database-types": "node scripts/generate-database-types.mjs",
    "verify:database-types": "node scripts/verify-database-types.mjs",
    "verify:clinical-artifact": "node --experimental-strip-types scripts/clinical/verify-artifact.mjs",
    "import:growth:who": "node scripts/clinical/import-who-growth.mjs",
    "import:growth:cdc": "node scripts/clinical/import-cdc-growth.mjs",
    "eval:runtime": "eve eval evals/runtime --strict --max-concurrency 1",
    "eval:runtime:json": "eve eval evals/runtime --strict --max-concurrency 1 --json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime": "vitest run tests/runtime",
    "test:immunization": "vitest run tests/clinical/immunization tests/persistence/immunization-repository.test.ts tests/persistence/clinical-package-repository.test.ts",
    "eval:immunization": "node --experimental-strip-types tests/evals/immunization.eval.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.44",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/connect": "0.4.2",
    "ai": "^7.0.34",
    "eve": "0.27.1",
    "jose": "6.2.9",
    "json-canonicalize": "^1.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "supabase": "^2.114.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "ai": "^7.0.34"
  },
  "engines": {
    "node": "24.x"
  }
}
