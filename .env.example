# Local development and tests: set APP_ENV explicitly to development or test.
APP_ENV=

# Preview and production secret managers must provide this server-only value.
# Never commit a real key or accept it from a request body.
GOOGLE_GENERATIVE_AI_API_KEY=

# Public Supabase project URL and publishable key; never use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Trusted job runtime only; never expose this key to browser, model, tool, or channel code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional explicit issuer; it must equal ${SUPABASE_URL}/auth/v1. Audience is fixed to authenticated.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
